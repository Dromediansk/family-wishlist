# The local Supabase stack in Docker. Committed on purpose, and read only by
# `npm run dev`.
#
# Nothing here is a secret: the two keys are the `supabase-demo` JWTs the CLI
# ships with, identical on every machine and addressing nothing but 127.0.0.1.
# They stay constant because the CLI version is pinned in package.json — if that
# pin is raised, check `npm run db:status` against this file, since newer CLIs
# have begun issuing sb_publishable_… / sb_secret_… keys instead.
#
# Do not create a .env.local, and see docs/setup/local-development.md
# ("Environment files") before adding any other dotenv file here.

# The local API gateway. Postgres itself is on 54422; this is what supabase-js
# talks to. Both ports come from supabase/config.toml.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421

# service_role. Never prefixed with NEXT_PUBLIC_, even for a disposable
# container.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# anon. Carries the session and joins the Realtime channel.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Left blank deliberately. It is worked out from the incoming request, which is
# right for localhost.
NEXT_PUBLIC_SITE_URL=
