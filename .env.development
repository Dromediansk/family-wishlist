# The local Supabase stack in Docker. Committed on purpose, and read only by
# `npm run dev` — NODE_ENV has to be development for Next to load this file.
#
# Nothing here is a secret. The two keys below are the `supabase-demo` JWTs the
# CLI ships with, signed with its built-in default secret; every developer who
# runs `npm run db:start` gets these exact strings, and they address nothing but
# 127.0.0.1. Committing them is what removes the old "run db:status and paste
# two keys" setup step — there was never anything machine-specific to paste.
#
# They stay constant because the CLI version is pinned in package.json. If that
# pin is ever raised, check `npm run db:status` against this file: newer CLIs
# have begun issuing sb_publishable_… / sb_secret_… keys instead.
#
# Precedence, and why the production values live in .env.production.local:
# Next resolves .env.development.local → .env.local → .env.development → .env.
# A file named .env.local would therefore outrank this one in development and
# quietly point `npm run dev` at the hosted project. Keeping the production
# values under .env.production.local leaves that slot empty.
#
# To point `npm run dev` somewhere else — the hosted project, say — copy
# .env.example to .env.development.local. It outranks this file and is
# gitignored. Nothing here has to be edited or swapped.

# The local API gateway. Postgres itself is on 54422; this is what supabase-js
# talks to. Both ports come from supabase/config.toml.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421

# service_role. Bypasses row level security and does all the data work, so it is
# never prefixed with NEXT_PUBLIC_ — the rule holds even when the database
# behind it is a disposable container.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# anon. Carries the session and joins the Realtime channel.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Left blank deliberately. It is worked out from the incoming request, which is
# right for localhost.
NEXT_PUBLIC_SITE_URL=
