# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the templates have no secrets in them and the README tells you to copy them.
# One pattern covers every one of them, at any depth — supabase/.env.example included —
# without this needing an edit each time another is added.
!.env*.example
# And .env.development is committed rather than copied: it holds the local stack's
# address and the CLI's public demo keys, which are the same on every machine. The
# file itself explains why that is not a secret. Overrides go in .env.development.local,
# which the rule above still ignores.
!.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/docs/superpowers/
