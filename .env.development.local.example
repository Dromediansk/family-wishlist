# Copy to .env.development.local and fill in from `npm run db:status`.
#
# Why this filename and not .env.local:
#
# Next loads .env.development.local at a higher priority than .env.local, and only when
# NODE_ENV is development. So `npm run dev` talks to the local Docker stack while
# `npm run build && npm start` still falls through to .env.local and its hosted project.
# Both work at once, nothing needs swapping, and there is no state to misremember.
#
# Getting the values: `npm run db:start`, then `npm run db:status`. The key format depends
# on the CLI version — recent releases moved from the legacy demo JWTs to sb_publishable_…
# and sb_secret_… — so copy what it prints rather than anything written down here.
#
# If a value is missing or misspelled, isConfigured() in src/lib/supabase.ts turns every
# page into the "connect your database" card and src/proxy.ts stops checking auth
# entirely, instead of throwing. That card is the symptom to look for.

# The local API gateway. Postgres itself is on 54422; this is what supabase-js talks to.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421

# From `npm run db:status` → service_role key.
#
# This one is only as dangerous as the database behind it, and locally that database is
# disposable. The rule against NEXT_PUBLIC_ still holds — it does all the data work
# server-side and must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# From `npm run db:status` → anon key. Carries the session and joins the Realtime channel.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Leave blank. It is worked out from the incoming request, which is right for localhost.
NEXT_PUBLIC_SITE_URL=
