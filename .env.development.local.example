# Copy to .env.development.local and fill in from `npm run db:status`.
#
# README's "A local database" section is the canonical account of why this filename and
# not .env.local, and of what a wrong value looks like from the outside. It is the copy to
# keep reading: this file gets copied to a gitignored one, and edits to README will never
# reach your copy of it.
#
# The one thing worth repeating here, because it is about the values below rather than
# about the file: the key format depends on the CLI version — recent releases moved from
# the legacy demo JWTs to sb_publishable_… and sb_secret_… — so copy what `npm run
# db:status` prints rather than anything written down anywhere.

# The local API gateway. Postgres itself is on 54422; this is what supabase-js talks to.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421

# From `npm run db:status` → service_role key.
#
# This one is only as dangerous as the database behind it, and locally that database is
# disposable. The rule against NEXT_PUBLIC_ still holds — it does all the data work
# server-side and must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# From `npm run db:status` → anon key. Carries the session and joins the Realtime channel.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Leave blank. It is worked out from the incoming request, which is right for localhost.
NEXT_PUBLIC_SITE_URL=
