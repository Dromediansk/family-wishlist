# Copy to .env.local and fill in from your Supabase project
# (Supabase dashboard → Project Settings → API).

# Your project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The service_role key — NOT the anon key.
#
# All reads and writes happen on the server with this key. It bypasses row level
# security, which is exactly why it must never be prefixed with NEXT_PUBLIC_ and
# must never reach the browser. Keep .env.local out of git (it already is) and
# set this as a secret in your host's dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# The anon key — this one DOES go to the browser, on purpose. Required.
#
# It does two jobs: it carries the visitor's Google sign-in session, and it lets
# open tabs join the Realtime channel that delivers the "something changed" ping
# behind live updates.
#
# It grants access to no table. Every table has row level security on with no
# policies (0001_init.sql), so even a signed-in user's session can read nothing
# directly — the app's privacy rule is enforced by server-side queries, and it
# only works while the browser cannot query at all. See 0002_realtime.sql.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Where Google should send people back to after they sign in.
#
# Leave it blank and it is worked out from the incoming request, which is right
# for localhost, previews and production alike. Set it only if you are behind
# something that rewrites the Host header. No trailing slash.
NEXT_PUBLIC_SITE_URL=
