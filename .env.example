# Copy to .env.local and fill in from your Supabase project
# (Supabase dashboard → Project Settings → API).

# Your project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The service_role key — NOT the anon key.
#
# This app has no login, so all reads and writes happen on the server with this
# key. It bypasses row level security, which is exactly why it must never be
# prefixed with NEXT_PUBLIC_ and must never reach the browser. Keep .env.local
# out of git (it already is) and set this as a secret in your host's dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# The anon key — this one DOES go to the browser, on purpose.
#
# It exists only so open tabs can join the Realtime channel that carries the
# "something changed" ping behind live updates. It grants access to no table:
# every table has row level security on with no policies (0001_init.sql), so
# the only thing this key can reach is a channel whose messages are empty.
#
# Optional. Leave it blank and the app works exactly as before, except other
# people's changes only appear when you switch back to the tab.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
