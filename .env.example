# Copy to .env.production.local and fill in from Supabase dashboard →
# Project Settings → API. Same values you set on your host.
#
# `npm run dev` does NOT use this file — it reads the committed .env.development
# and talks to the local Docker stack. See docs/setup/local-development.md
# ("Environment files"), and docs/setup/production.md for what each value is.

# Your project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The service_role key — NOT the anon key. It bypasses row level security, so it
# must never be prefixed with NEXT_PUBLIC_ and must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The anon key — this one DOES go to the browser, on purpose. Required: it
# carries the sign-in session and joins the live-update channel. It grants access
# to no table. docs/content/privacy-rule.md
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Where Google sends people back to after signing in. Left blank it is
# worked out from the request, which is right everywhere; set it only behind
# something that rewrites the Host header. No trailing slash.
NEXT_PUBLIC_SITE_URL=
