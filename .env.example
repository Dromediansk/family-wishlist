# Copy to .env.local and fill in from your Supabase project
# (Supabase dashboard → Project Settings → API).

# Your project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The service_role key — NOT the anon key.
#
# This app has no login, so all reads and writes happen on the server with this
# key. It bypasses row level security, which is exactly why it must never be
# prefixed with NEXT_PUBLIC_ and must never reach the browser. Keep .env.local
# out of git (it already is) and set this as a secret in your host's dashboard.
SUPABASE_SERVICE_ROLE_KEY=
